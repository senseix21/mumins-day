<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later. Nothing is backed up or transferred yet: the app stores nothing so far.
    Phase 4 decides the real rules (settings and deed completions in, alarm log out) and must re-run the
    health check after a restore, because exact-alarm permission is denied on a restored install.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
