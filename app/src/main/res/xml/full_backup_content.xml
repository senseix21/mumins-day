<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11. The same rule as data_extraction_rules.xml: nothing is backed up yet. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
