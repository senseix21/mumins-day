{"result":[{"id":"6024","sura":"90","aya":"1","arabic_text":"\u0644\u064e\u0627\u0653 \u0623\u064f\u0642\u06e1\u0633\u0650\u0645\u064f \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u064e\u0644\u064e\u062f\u0650","translation":"\u0986\u09ae\u09bf [\u09e7] \u09b6\u09aa\u09a5 \u0995\u09b0\u099b\u09bf \u098f \u09a8\u0997\u09b0\u09c7\u09b0 [\u09e8]","footnotes":"\u09ef\u09e6- \u09b8\u09c2\u09b0\u09be \u0986\u09b2-\u09ac\u09be\u09b2\u09be\u09a6\n\u09e8\u09e6 \u0986\u09df\u09be\u09a4, \u09ae\u0995\u09cd\u0995\u09c0\n\n[\u09e7] \u098f \u09b8\u09c2\u09b0\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7\u0987 \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u0644\u0627 \u09b6\u09ac\u09cd\u09a6\u099f\u09bf\u09b0 \u0985\u09b0\u09cd\u09a5, \u09a8\u09be\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u098f\u0996\u09be\u09a8\u09c7 \u0644\u0627 \u09b6\u09ac\u09cd\u09a6\u099f\u09bf \u0995\u09bf \u0985\u09b0\u09cd\u09a5\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u098f \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u09a6\u09c1\u2018\u099f\u09bf \u09ae\u09a4 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u0995. \u098f\u0996\u09be\u09a8\u09c7 \u0644\u0627 \u09b6\u09ac\u09cd\u09a6\u099f\u09bf \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u098f\u09ac\u0982 \u0986\u09b0\u09ac\u09c0 \u09ac\u09be\u0995\u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u09a4\u09c7 \u098f\u09b0 \u0985\u09a4\u09bf\u09b0\u09bf\u0995\u09cd\u09a4 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09b8\u09c1\u09ac\u09bf\u09a6\u09bf\u09a4\u0964 \u09a4\u09ac\u09c7 \u09ac\u09bf\u09b6\u09c1\u09a6\u09cd\u09a7 \u0989\u0995\u09cd\u09a4\u09bf \u098f\u0987 \u09af\u09c7, \u09aa\u09cd\u09b0\u09a4\u09bf\u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09ad\u09cd\u09b0\u09be\u09a8\u09cd\u09a4 \u09a7\u09be\u09b0\u09a3\u09be \u0996\u09a3\u09cd\u09a1\u09a8 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u09c7 \u098f\u0987 \u0644\u0627 \u09b6\u09ac\u09cd\u09a6\u099f\u09bf \u09b6\u09aa\u09a5 \u09ac\u09be\u0995\u09cd\u09af\u09c7\u09b0 \u09b6\u09c1\u09b0\u09c1\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09af\u09bc\u0964 \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af \u098f\u0987 \u09af\u09c7, \u098f\u099f\u09be \u0995\u09c7\u09ac\u09b2 \u0986\u09aa\u09a8\u09be\u09b0 \u09a7\u09be\u09b0\u09a3\u09be \u09a8\u09af\u09bc; \u09ac\u09b0\u0982 \u0986\u09ae\u09bf \u09b6\u09aa\u09a5 \u09b8\u09b9\u0995\u09be\u09b0\u09c7 \u09af\u09be \u09ac\u09b2\u099b\u09bf, \u09a4\u09be\u0987 \u09ac\u09be\u09b8\u09cd\u09a4\u09ac \u09b8\u09a4\u09cd\u09af \u0985\u09a5\u09ac\u09be \u0985\u09ae\u09c1\u0995 \u0985\u09ae\u09c1\u0995 \u099c\u09bf\u09a8\u09bf\u09b8\u09c7\u09b0 \u0995\u09b8\u09ae \u0996\u09c7\u09af\u09bc\u09c7 \u09ac\u09b2\u099b\u09bf \u0986\u09b8\u09b2 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0 \u09b9\u099a\u09cd\u099b\u09c7 \u098f\u0987\u0964  [\u09a6\u09c7\u0996\u09c1\u09a8, \u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0]\n\n[\u09e8] \u0627\u0644\u0628\u0644\u062f \u09ac\u09be \u09a8\u0997\u09b0\u09c0 \u09ac\u09b2\u09c7 \u098f\u0996\u09be\u09a8\u09c7 \u09ae\u0995\u09cd\u0995\u09be \u09a8\u0997\u09b0\u09c0\u0995\u09c7 \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 [\u0987\u09ac\u09a8 \u0995\u09be\u09b8\u09c0\u09b0] \u09b8\u09c2\u09b0\u09be \u0986\u09a4-\u09a4\u09cd\u09ac\u09c0\u09a8\u09c7\u0993 \u098f\u09ae\u09a8\u09bf\u09ad\u09be\u09ac\u09c7 \u09ae\u0995\u09cd\u0995\u09be \u09a8\u0997\u09b0\u09c0\u09b0 \u09b6\u09aa\u09a5 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09a4\u09a6\u09b8\u0999\u09cd\u0997\u09c7 \u0623\u0645\u064a\u0646 \u09ac\u09bf\u09b6\u09c7\u09b7\u09a3\u0993 \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964"},{"id":"6025","sura":"90","aya":"2","arabic_text":"\u0648\u064e\u0623\u064e\u0646\u062a\u064e \u062d\u0650\u0644\u0651\u064f\u06e2 \u0628\u0650\u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u06e1\u0628\u064e\u0644\u064e\u062f\u0650","translation":"\u0986\u09b0 \u0986\u09aa\u09a8\u09bf \u098f \u09a8\u0997\u09b0\u09c7\u09b0 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c0 [\u09e7],","footnotes":"[\u09e7]  \u062d\u0650\u0644\u0651\u064f\u06e2 \u09b6\u09ac\u09cd\u09a6\u09c7\u09b0 \u09a6\u09c1\u099f\u09bf \u0985\u09b0\u09cd\u09a5 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 (\u098f\u0995) \u098f\u099f\u09be \u062d\u0644\u0648\u0644 \u09a5\u09c7\u0995\u09c7 \u0989\u09a6\u09cd\u09ad\u09c2\u09a4\u0964 \u0985\u09b0\u09cd\u09a5 \u0995\u09cb\u09a8\u09cb \u0995\u09bf\u099b\u09c1\u09a4\u09c7 \u0985\u09ac\u09b8\u09cd\u09a5\u09be\u09a8 \u09a8\u09c7\u09af\u09bc\u09be, \u09a5\u09be\u0995\u09be \u0993 \u0985\u09ac\u09a4\u09b0\u09a3 \u0995\u09b0\u09be\u0964 \u09b8\u09c7 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u0986\u09af\u09bc\u09be\u09a4\u09c7\u09b0 \u09ae\u09b0\u09cd\u09ae\u09be\u09b0\u09cd\u09a5 \u098f\u0987 \u09af\u09c7, \u09ae\u0995\u09cd\u0995\u09be \u09a8\u0997\u09b0\u09c0 \u09a8\u09bf\u099c\u09c7\u0993 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u09bf\u09a4 \u0993 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0, \u09ac\u09bf\u09b6\u09c7\u09b7\u09a4 \u0986\u09aa\u09a8\u09bf\u0993 \u098f \u09a8\u0997\u09b0\u09c0\u09a4\u09c7 \u09ac\u09b8\u09ac\u09be\u09b8 \u0995\u09b0\u09c7\u09a8\u0964 \u09ac\u09b8\u09ac\u09be\u09b8\u0995\u09be\u09b0\u09c0\u09b0 \u09b6\u09cd\u09b0\u09c7\u09b7\u09cd\u09a0\u09a4\u09cd\u09ac\u09c7\u09b0 \u09a6\u09b0\u09c1\u09a8\u0993 \u09ac\u09be\u09b8\u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u09b6\u09cd\u09b0\u09c7\u09b7\u09cd\u09a0\u09a4\u09cd\u09ac \u09ac\u09c7\u09a1\u09bc\u09c7 \u09af\u09be\u09af\u09bc\u0964 \u0995\u09be\u099c\u09c7\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09b8\u09ac\u09be\u09b8\u09c7\u09b0 \u0995\u09be\u09b0\u09a3\u09c7 \u098f \u09a8\u0997\u09b0\u09c0\u09b0 \u09ae\u09be\u09b9\u09be\u09a4\u09cd\u09ae\u09cd\u09af \u0993 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8 \u09a6\u09cd\u09ac\u09bf\u0997\u09c1\u09a3 \u09b9\u09af\u09bc\u09c7 \u0997\u09c7\u099b\u09c7\u0964 [\u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0] (\u09a6\u09c1\u0987) \u098f\u099f\u09be \u062d\u0644\u0627\u0644 \u09a5\u09c7\u0995\u09c7 \u0989\u09a6\u09cd\u09ad\u09c2\u09a4\u0964 \u0985\u09b0\u09cd\u09a5 \u09b9\u09be\u09b2\u09be\u09b2 \u09b9\u0993\u09af\u09bc\u09be\u0964 \u098f\u09a6\u09bf\u0995 \u09a6\u09bf\u09af\u09bc\u09c7 \u098f\u0995 \u0985\u09b0\u09cd\u09a5 \u098f\u0987 \u09af\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09ae\u0995\u09cd\u0995\u09be\u09b0 \u0995\u09be\u09ab\u09c7\u09b0\u09b0\u09be \u09b9\u09be\u09b2\u09be\u09b2 \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09b0\u09c7\u0996\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b9\u09a4\u09cd\u09af\u09be \u0995\u09b0\u09be\u09b0 \u09ab\u09bf\u0995\u09bf\u09b0\u09c7 \u09b0\u09af\u09bc\u09c7\u099b\u09c7; \u0985\u09a5\u099a \u09a4\u09be\u09b0\u09be \u09a8\u09bf\u099c\u09c7\u09b0\u09be\u0993 \u09ae\u0995\u09cd\u0995\u09be \u09a8\u0997\u09b0\u09c0\u09a4\u09c7 \u0995\u09cb\u09a8\u09cb \u09b6\u09bf\u0995\u09be\u09b0\u0995\u09c7\u0987 \u09b9\u09be\u09b2\u09be\u09b2 \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09a8\u09be\u0964 \u098f\u09ae\u09a4\u09be\u09ac\u09b8\u09cd\u09a5\u09be\u09af\u09bc \u09a4\u09be\u09a6\u09c7\u09b0 \u09af\u09c1\u09b2\u09c1\u09ae \u0993 \u0985\u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be \u0995\u09a4\u099f\u09c1\u0995\u09c1 \u09af\u09c7, \u09a4\u09be\u09b0\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09b0 \u09b0\u09be\u09b8\u09c2\u09b2\u09c7\u09b0 \u09b9\u09a4\u09cd\u09af\u09be\u0995\u09c7 \u09b9\u09be\u09b2\u09be\u09b2 \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u0985\u09aa\u09b0 \u0985\u09b0\u09cd\u09a5 \u098f\u0987 \u09af\u09c7, \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u09c7 \u09ae\u0995\u09cd\u0995\u09be\u09b0 \u09b9\u09be\u09b0\u09be\u09ae\u09c7 \u0995\u09be\u09ab\u09c7\u09b0\u09a6\u09c7\u09b0 \u09ac\u09bf\u09b0\u09c1\u09a6\u09cd\u09a7\u09c7 \u09af\u09c1\u09a6\u09cd\u09a7 \u0995\u09b0\u09be \u09b9\u09be\u09b2\u09be\u09b2 \u0995\u09b0\u09c7 \u09a6\u09c7\u0993\u09af\u09bc\u09be \u09b9\u09ac\u09c7\u0964 [\u0987\u09ac\u09a8 \u0995\u09be\u09b8\u09c0\u09b0] \u09ac\u09b8\u09cd\u09a4\u09c1\u09a4 \u09ae\u0995\u09cd\u0995\u09be \u09ac\u09bf\u099c\u09af\u09bc\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc \u098f\u0995\u09a6\u09bf\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af\u09c7\u0987 \u09a4\u09be\u0987 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u0964 \u0986\u09a8\u09be\u09b8 \u0987\u09ac\u09a8 \u09ae\u09be\u09b2\u09bf\u0995 \u09b0\u09be\u09a6\u09bf\u09af\u09bc\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u2018\u0986\u09a8\u09b9\u09c1 \u09ac\u09b2\u09c7\u09a8, \u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09af\u09bc\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09ae\u0995\u09cd\u0995\u09be \u09ac\u09bf\u099c\u09af\u09bc\u09c7\u09b0 \u09a6\u09bf\u09a8 \u09ae\u09be\u09a5\u09be\u09af\u09bc \u09b6\u09bf\u09b0\u09b8\u09cd\u09a4\u09cd\u09f0\u09be\u09a3 \u09aa\u09b0\u09bf\u09a7\u09be\u09a8 \u0995\u09b0\u09c7 \u09ae\u0995\u09cd\u0995\u09be\u09af\u09bc \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09b2\u09c7\u09a8, \u09a4\u09be\u09b0\u09aa\u09b0 \u09af\u0996\u09a8 \u09a4\u09bf\u09a8\u09bf \u09a4\u09be \u0996\u09c1\u09b2\u09b2\u09c7\u09a8, \u098f\u0995 \u09b2\u09cb\u0995 \u098f\u09b8\u09c7 \u09a4\u09be\u0995\u09c7 \u09ac\u09b2\u09b2 \u09af\u09c7, \u0987\u09ac\u09a8 \u0996\u09be\u09a4\u09b2 \u0995\u09be\u2018\u09ac\u09be\u09b0 \u09aa\u09b0\u09cd\u09a6\u09be \u09a7\u09b0\u09c7 \u0986\u099b\u09c7\u0964 \u09a4\u09bf\u09a8\u09bf \u09ac\u09b2\u09b2\u09c7\u09a8, \u2018\u09a4\u09be\u0995\u09c7 \u09b9\u09a4\u09cd\u09af\u09be \u0995\u09b0\u2019\u0964 [\u09ac\u09c1\u0996\u09be\u09b0\u09c0 \u09e7\u09ee\u09ea\u09ec, \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u09ea\u09eb\u09e6] \u0995\u09be\u09b0\u09a3, \u09aa\u09c2\u09b0\u09cd\u09ac \u09a5\u09c7\u0995\u09c7\u0987 \u09a4\u09be\u09b0 \u09ae\u09c3\u09a4\u09cd\u09af\u09c1\u09a6\u09a3\u09cd\u09a1\u09c7\u09b0 \u0998\u09cb\u09b7\u09a3\u09be \u09b0\u09be\u09b8\u09c2\u09b2 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u09c7\u09a8\u0964"},{"id":"6026","sura":"90","aya":"3","arabic_text":"\u0648\u064e\u0648\u064e\u0627\u0644\u0650\u062f\u0656 \u0648\u064e\u0645\u064e\u0627 \u0648\u064e\u0644\u064e\u062f\u064e","translation":"\u09b6\u09aa\u09a5 \u099c\u09a8\u09cd\u09ae\u09a6\u09be\u09a4\u09be\u09b0 \u0993 \u09af\u09be \u09b8\u09c7 \u099c\u09a8\u09cd\u09ae \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7 [\u09e7]\u0964","footnotes":"[\u09e7] \u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u09ac\u09be\u09aa \u0993 \u09a4\u09be\u09b0 \u0994\u09b0\u09b8\u09c7 \u099c\u09a8\u09cd\u09ae \u0997\u09cd\u09b0\u09b9\u09a3\u0995\u09be\u09b0\u09c0 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u09a6\u09c7\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u09c7 \u09ac\u09cd\u09af\u09aa\u0995 \u0985\u09f0\u09cd\u09a5\u09ac\u09cb\u09a7\u0995 \u09b6\u09ac\u09cd\u09a6 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09b8\u09be\u09ae\u09a8\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u0995\u09a5\u09be \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09a4\u09be\u0987 \u09ac\u09be\u09aa \u09ae\u09be\u09a8\u09c7 \u0986\u09a6\u09ae \u0986\u09b2\u09be\u0987\u09b9\u09bf\u09b8 \u09b8\u09be\u09b2\u09be\u09ae\u0987 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09b0 \u09a4\u09be\u0981\u09b0 \u0994\u09b0\u09b8\u09c7 \u099c\u09a8\u09cd\u09ae \u0997\u09cd\u09b0\u09b9\u09a3\u0995\u09be\u09b0\u09c0 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8 \u09ac\u09b2\u09a4\u09c7 \u09a6\u09c1\u09a8\u09bf\u09af\u09bc\u09be\u09af\u09bc \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09af\u09a4 \u09ae\u09be\u09a8\u09c1\u09b7 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc, \u09af\u09a4 \u09ae\u09be\u09a8\u09c1\u09b7 \u0985\u09a4\u09c0\u09a4\u09c7 \u09aa\u09be\u0993\u09af\u09bc\u09be \u0997\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09ad\u09ac\u09bf\u09b7\u09cd\u09af\u09a4\u09c7\u0993 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09ac\u09c7 \u09b8\u09ac\u09be\u0987\u0995\u09c7 \u09ac\u09c1\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u09ad\u09be\u09ac\u09c7 \u098f\u09a4\u09c7 \u0986\u09a6\u09ae \u0993 \u09a6\u09c1\u09a8\u09bf\u09af\u09bc\u09be\u09b0 \u0986\u09a6\u09bf \u09a5\u09c7\u0995\u09c7 \u0985\u09a8\u09cd\u09a4 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09b8\u09ac \u09ac\u09a8\u09c0-\u0986\u09a6\u09ae\u09c7\u09b0 \u09b6\u09aa\u09a5 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u0985\u09a5\u09ac\u09be \u0648\u064e\u0627\u0644\u0650\u062f\u064c \u09ac\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u099c\u09a8\u09cd\u09ae\u09a6\u09be\u09a8\u0995\u09be\u09b0\u09c0 \u09aa\u09bf\u09a4\u09be \u0986\u09b0 \u0648\u064e\u0644\u064e\u062f\u064e  \u09ac\u09b2\u09c7 \u09aa\u09cd\u09b0\u09a4\u09cd\u09af\u09c7\u0995 \u09b8\u09a8\u09cd\u09a4\u09be\u09a8\u0995\u09c7 \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 [\u0987\u09ac\u09a8 \u0995\u09be\u09b8\u09c0\u09b0; \u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0]"},{"id":"6027","sura":"90","aya":"4","arabic_text":"\u0644\u064e\u0642\u064e\u062f\u06e1 \u062e\u064e\u0644\u064e\u0642\u06e1\u0646\u064e\u0627 \u0671\u0644\u06e1\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0641\u0650\u064a \u0643\u064e\u0628\u064e\u062f\u064d","translation":"\u09a8\u09bf\u0983\u09b8\u09a8\u09cd\u09a6\u09c7\u09b9\u09c7 \u0986\u09ae\u09b0\u09be \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf \u0995\u09b7\u09cd\u099f-\u0995\u09cd\u09b2\u09c7\u09b6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 [\u09e7]\u0964","footnotes":"[\u09e7] \u098f\u0996\u09be\u09a8\u09c7 \u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09b0\u09cd\u09a4\u09c0 \u09b6\u09aa\u09a5\u09b8\u09ae\u09c2\u09b9\u09c7\u09b0 \u099c\u0993\u09af\u09bc\u09be\u09ac\u09c7 \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09af\u09c7,\r\n\r\n \u0644\u064e\u0642\u064e\u062f\u0652 \u062e\u064e\u0644\u064e\u0642\u0652\u0646\u064e\u0627 \u0627\u0644\u0652\u0627\u0650\u0646\u0652\u0633\u064e\u0627\u0646\u064e \u0641\u0650\u0649 \u0643\u064e\u0628\u064e\u062f\u064d \r\n\r\n\u0986\u09af\u09bc\u09be\u09a4\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4 \u0643\u0628\u062f \u098f\u09b0 \u09b6\u09be\u09ac\u09cd\u09a6\u09bf\u0995 \u0985\u09b0\u09cd\u09a5 \u09b6\u09cd\u09b0\u09ae \u0993 \u0995\u09b7\u09cd\u099f\u0964 \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u09ae\u09be\u09a8\u09c1\u09b7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf\u0997\u09a4\u09ad\u09be\u09ac\u09c7 \u0986\u099c\u09c0\u09ac\u09a8 \u09b6\u09cd\u09b0\u09ae \u0993 \u0995\u09b7\u09cd\u099f\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a5\u09be\u0995\u09c7\u0964 [\u0987\u09ac\u09a8 \u0995\u09be\u09b8\u09c0\u09b0; \u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0]"},{"id":"6028","sura":"90","aya":"5","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0623\u064e\u0646 \u0644\u0651\u064e\u0646 \u064a\u064e\u0642\u06e1\u062f\u0650\u0631\u064e \u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650 \u0623\u064e\u062d\u064e\u062f\u065e","translation":"\u09b8\u09c7 \u0995\u09bf \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09af\u09c7, \u0995\u0996\u09a8\u09cb \u09a4\u09be\u09b0 \u0989\u09aa\u09b0 \u0995\u09c7\u0989 \u0995\u09cd\u09b7\u09ae\u09a4\u09be\u09ac\u09be\u09a8 \u09b9\u09ac\u09c7 \u09a8\u09be?","footnotes":""},{"id":"6029","sura":"90","aya":"6","arabic_text":"\u064a\u064e\u0642\u064f\u0648\u0644\u064f \u0623\u064e\u0647\u06e1\u0644\u064e\u0643\u06e1\u062a\u064f \u0645\u064e\u0627\u0644\u0657\u0627 \u0644\u0651\u064f\u0628\u064e\u062f\u064b\u0627","translation":"\u09b8\u09c7 \u09ac\u09b2\u09c7, \u2018\u0986\u09ae\u09bf \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u0985\u09b0\u09cd\u09a5 \u09a8\u09bf\u0983\u09b6\u09c7\u09b7 \u0995\u09b0\u09c7\u099b\u09bf [\u09e7]\u0964\u2019","footnotes":"[\u09e7] \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09b8\u09c7 \u09ac\u09b2\u09c7 \u201c\u0986\u09ae\u09bf \u09aa\u09cd\u09b0\u099a\u09c1\u09b0 \u09a7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09a6 \u0989\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u0964\u201d \u098f\u0987 \u09b6\u09ac\u09cd\u09a6\u0997\u09c1\u09b2\u09cb\u0987 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09c7, \u09ac\u0995\u09cd\u09a4\u09be \u09a4\u09be\u09b0 \u09a7\u09a8-\u09b8\u09ae\u09cd\u09aa\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09be\u099a\u09c1\u09b0\u09cd\u09af\u09c7 \u0995\u09c0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u0997\u09b0\u09cd\u09ac\u09bf\u09a4\u0964 \u09af\u09c7 \u09ac\u09bf\u09aa\u09c1\u09b2 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u09a7\u09a8 \u09b8\u09c7 \u0996\u09b0\u099a \u0995\u09b0\u09c7\u099b\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09bf\u0995 \u09b8\u09ae\u09cd\u09aa\u09a6\u09c7\u09b0 \u09a4\u09c1\u09b2\u09a8\u09be\u09af\u09bc \u09a4\u09be\u09b0 \u0995\u09be\u099b\u09c7 \u09a4\u09be\u09b0 \u09aa\u09b0\u09bf\u09ae\u09be\u09a3 \u098f\u09a4 \u09b8\u09be\u09ae\u09be\u09a8\u09cd\u09af \u099b\u09bf\u09b2 \u09af\u09c7, \u09a4\u09be \u0989\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09ac\u09be \u09ab\u09c1\u0981\u0995\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u09df\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09aa\u09b0\u09cb\u09af\u09bc\u09be\u0987 \u09b8\u09c7 \u0995\u09b0\u09c7\u09a8\u09bf\u0964 \u0986\u09b0 \u098f\u0987 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09b8\u09c7 \u0995\u09cb\u09a8 \u0995\u09be\u099c\u09c7 \u0989\u09a1\u09bc\u09bf\u09af\u09bc\u09c7\u099b\u09c7? \u0995\u09cb\u09a8\u09cb \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09a8\u09c7\u0995\u09c0\u09b0 \u0995\u09be\u099c\u09c7 \u09a8\u09af\u09bc, \u09af\u09c7\u09ae\u09a8 \u09b8\u09be\u09ae\u09a8\u09c7\u09b0 \u0986\u09af\u09bc\u09be\u09a4\u0997\u09c1\u09b2\u09cb \u09a5\u09c7\u0995\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09bf\u09a4 \u09b9\u099a\u09cd\u099b\u09c7\u0964 \u09ac\u09b0\u0982 \u098f\u0987 \u09b8\u09ae\u09cd\u09aa\u09a6 \u09b8\u09c7 \u0989\u09a1\u09bc\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09a7\u09a8\u09be\u09a2\u09cd\u09af\u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09a6\u09b0\u09cd\u09b6\u09a8\u09c0 \u098f\u09ac\u0982 \u09a8\u09bf\u099c\u09c7\u09b0 \u0985\u09b9\u0982\u0995\u09be\u09b0 \u0993 \u09b6\u09cd\u09b0\u09c7\u09b7\u09cd\u09a0\u09a4\u09cd\u09ac \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0964"},{"id":"6030","sura":"90","aya":"7","arabic_text":"\u0623\u064e\u064a\u064e\u062d\u06e1\u0633\u064e\u0628\u064f \u0623\u064e\u0646 \u0644\u0651\u064e\u0645\u06e1 \u064a\u064e\u0631\u064e\u0647\u064f\u06e5\u0653 \u0623\u064e\u062d\u064e\u062f\u064c","translation":"\u09b8\u09c7 \u0995\u09bf \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09af\u09c7, \u09a4\u09be\u0995\u09c7 \u0995\u09c7\u0989 \u09a6\u09c7\u0996\u09c7\u09a8\u09bf?","footnotes":""},{"id":"6031","sura":"90","aya":"8","arabic_text":"\u0623\u064e\u0644\u064e\u0645\u06e1 \u0646\u064e\u062c\u06e1\u0639\u064e\u0644 \u0644\u0651\u064e\u0647\u064f\u06e5 \u0639\u064e\u064a\u06e1\u0646\u064e\u064a\u06e1\u0646\u0650","translation":"\u0986\u09ae\u09b0\u09be \u0995\u09bf \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09bf\u09a8\u09bf \u09a6\u09c1\u099a\u09cb\u0996 ?","footnotes":""},{"id":"6032","sura":"90","aya":"9","arabic_text":"\u0648\u064e\u0644\u0650\u0633\u064e\u0627\u0646\u0657\u0627 \u0648\u064e\u0634\u064e\u0641\u064e\u062a\u064e\u064a\u06e1\u0646\u0650","translation":"\u0986\u09b0 \u099c\u09bf\u09b9\u09cd\u09ac\u09be \u0993 \u09a6\u09c1\u0987 \u09a0\u09cb\u0981\u099f ?","footnotes":""},{"id":"6033","sura":"90","aya":"10","arabic_text":"\u0648\u064e\u0647\u064e\u062f\u064e\u064a\u06e1\u0646\u064e\u0670\u0647\u064f \u0671\u0644\u0646\u0651\u064e\u062c\u06e1\u062f\u064e\u064a\u06e1\u0646\u0650","translation":"\u0986\u09b0 \u0986\u09ae\u09b0\u09be \u09a4\u09be\u0995\u09c7 \u09a6\u09c7\u0996\u09bf\u09af\u09bc\u09c7\u099b\u09bf [\u09e7] \u09a6\u09c1\u2019\u099f\u09bf \u09aa\u09a5 [\u09e8]\u0964","footnotes":"[\u09e7] \u0985\u09b0\u09cd\u09a5\u09be\u09ce \u09ad\u09be\u09b2 \u0993 \u09ae\u09a8\u09cd\u09a6 \u09a6\u09c1\u2019\u099f\u09bf \u09aa\u09a5\u09c7\u09b0 \u09a6\u09bf\u09b6\u09be\u0987 \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09a4\u09be\u2018\u0986\u09b2\u09be \u09a4\u09be\u0981\u09b0 \u09ac\u09be\u09a8\u09cd\u09a6\u09be\u0995\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09f0 \u09ac\u09c1\u09a6\u09cd\u09a7\u09bf \u0993 \u099a\u09bf\u09a8\u09cd\u09a4\u09be\u09b0 \u09b6\u0995\u09cd\u09a4\u09bf \u09a6\u09be\u09a8 \u0995\u09b0\u09c7 \u09a4\u09be\u0995\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09aa\u09a5 \u09a8\u09bf\u099c\u09c7 \u0996\u09c1\u0981\u099c\u09c7 \u09a8\u09c7\u09ac\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u099b\u09c7\u09a1\u09bc\u09c7 \u09a6\u09c7\u09a8\u09a8\u09bf\u0964 \u09ac\u09b0\u0982 \u09a4\u09be\u0995\u09c7 \u09aa\u09a5 \u09a6\u09c7\u0996\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u09a4\u09be\u09b0 \u09b8\u09be\u09ae\u09a8\u09c7 \u09ad\u09be\u09b2\u09cb \u0993 \u09ae\u09a8\u09cd\u09a6 \u098f\u09ac\u0982 \u09a8\u09c7\u0995\u09c0 \u0993 \u0997\u09cb\u09a8\u09be\u09b9\u09c7\u09b0 \u09a6\u09c1\u2019\u099f\u09bf \u09aa\u09a5 \u09b8\u09c1\u09b8\u09cd\u09aa\u09b7\u09cd\u099f \u0995\u09b0\u09c7 \u09a4\u09c1\u09b2\u09c7 \u09a7\u09b0\u09c7\u099b\u09c7\u09a8\u0964 \u09ad\u09be\u09b2\u09cb\u09ad\u09be\u09ac\u09c7 \u099a\u09bf\u09a8\u09cd\u09a4\u09be-\u09ad\u09be\u09ac\u09a8\u09be \u0995\u09b0\u09c7 \u09a4\u09be\u09b0 \u09ae\u09a7\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09a8\u09bf\u099c \u09a6\u09be\u09af\u09bc\u09bf\u09a4\u09cd\u09ac\u09c7 \u09af\u09c7 \u09aa\u09a5\u099f\u09bf \u0987\u099a\u09cd\u099b\u09be \u09b8\u09c7 \u0997\u09cd\u09f0\u09b9\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u09aa\u09ac\u09bf\u09a4\u09cd\u09b0 \u0995\u09c1\u09b0\u0986\u09a8\u09c7\u09b0 \u0985\u09a8\u09cd\u09af\u09a4\u09cd\u09b0\u0993 \u098f\u0987 \u098f\u0995\u0987 \u0995\u09a5\u09be \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u098f\u09b8\u09c7\u099b\u09c7, \u201c\u0986\u09ae\u09bf \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u098f\u0995\u099f\u09bf \u09ae\u09bf\u09b6\u09cd\u09b0\u09bf\u09a4 \u09ac\u09c0\u09b0\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09b8\u09c3\u09b7\u09cd\u099f\u09bf \u0995\u09b0\u09c7\u099b\u09bf, \u09af\u09be\u09a4\u09c7 \u09a4\u09be\u09b0 \u09aa\u09b0\u09c0\u0995\u09cd\u09b7\u09be \u09a8\u09c7\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc \u098f\u09ac\u0982 \u098f \u0989\u09a6\u09cd\u09a6\u09c7\u09b6\u09cd\u09af\u09c7 \u0986\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u09b6\u09cd\u09b0\u09ac\u09a3 \u09b6\u0995\u09cd\u09a4\u09bf \u0993 \u09a6\u09c3\u09b7\u09cd\u099f\u09bf\u09b6\u0995\u09cd\u09a4\u09bf\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0\u09c0 \u0995\u09b0\u09c7\u099b\u09bf\u0964 \u0986\u09ae\u09bf \u09a4\u09be\u0995\u09c7 \u09aa\u09a5 \u09a6\u09c7\u0996\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf, \u099a\u09be\u0987\u09b2\u09c7 \u09b8\u09c7 \u09b6\u09cb\u0995\u09b0\u0995\u09be\u09b0\u09c0 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u09ac\u09be \u0995\u09c1\u09ab\u09b0\u0995\u09be\u09b0\u09c0\u0964\u201d [\u09b8\u09c2\u09b0\u09be \u0986\u09b2-\u0987\u09a8\u09b8\u09be\u09a8 \u09e8-\u09e9]\n\n[\u09e8] \u0646\u064e\u062c\u0652\u062f\u064e\u064a\u0652\u0646\u0650 \u09b6\u09ac\u09cd\u09a6\u099f\u09bf \u0646\u064e\u062c\u0652\u062f\u064c \u098f\u09b0 \u09a6\u09cd\u09ac\u09bf\u09ac\u099a\u09a8\u0964 \u098f\u09b0 \u09b6\u09be\u09ac\u09cd\u09a6\u09bf\u0995 \u0985\u09b0\u09cd\u09a5 \u0989\u09b0\u09cd\u09a7\u09cd\u09ac\u0997\u09be\u09ae\u09c0 \u09aa\u09a5\u0964 [\u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0] \u098f\u0996\u09be\u09a8\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09cd\u09af \u09aa\u09a5 \u09ac\u09cb\u099d\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u09aa\u09a5 \u09a6\u09c1\u099f\u09bf\u09b0 \u098f\u0995\u099f\u09bf \u09b9\u099a\u09cd\u099b\u09c7 \u09b8\u09cc\u09ad\u09be\u0997\u09cd\u09af \u0993 \u09b8\u09be\u09ab\u09b2\u09cd\u09af\u09c7\u09b0 \u09aa\u09a5 \u098f\u09ac\u0982 \u0985\u09aa\u09b0\u099f\u09bf \u09b9\u099a\u09cd\u099b\u09c7 \u0985\u09a8\u09bf\u09b7\u09cd\u099f \u0993 \u09a7\u09cd\u09ac\u0982\u09b8\u09c7\u09b0 \u09aa\u09a5\u0964 \u098f \u09aa\u09a5 \u09a6\u09c1\u2019\u099f\u09bf\u09b0 \u098f\u0995\u099f\u09bf \u0997\u09c7\u099b\u09c7 \u0993\u09aa\u09b0\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7\u0964 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u09b8\u09c7\u0996\u09be\u09a8\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b9\u09b2\u09c7 \u0996\u09c1\u09ac \u0995\u09b7\u09cd\u099f \u0993 \u09aa\u09b0\u09bf\u09b6\u09cd\u09b0\u09ae \u0995\u09b0\u09a4\u09c7 \u09b9\u09af\u09bc\u0964 \u09b8\u09c7 \u09aa\u09a5\u099f\u09bf \u09ac\u09a1\u09bc\u0987 \u09a6\u09c1\u09f0\u09cd\u0997\u09ae\u0964 \u09b8\u09c7 \u09aa\u09a5\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b9\u09b2\u09c7 \u09ae\u09be\u09a8\u09c1\u09b7\u0995\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf \u0993 \u09a4\u09be\u09b0 \u0986\u0995\u09be\u0982\u0996\u09be \u098f\u09ac\u0982 \u09b6\u09af\u09bc\u09a4\u09be\u09a8\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b0\u09cb\u099a\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b2\u09a1\u09bc\u09be\u0987 \u0995\u09b0\u09c7 \u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09b9\u09af\u09bc\u0964 \u0986\u09b0 \u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc \u09aa\u09a5\u099f\u09bf \u09ac\u09a1\u09bc\u0987 \u09b8\u09b9\u099c\u0964 \u098f\u099f\u09bf \u0996\u09be\u09a6\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09a8\u09c7\u09ae\u09c7 \u0997\u09c7\u099b\u09c7\u0964 \u098f\u0987 \u09aa\u09a5 \u09a6\u09bf\u09af\u09bc\u09c7 \u09a8\u09c0\u099a\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u09a8\u09c7\u09ae\u09c7 \u09af\u09be\u0993\u09df\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u09cb \u09aa\u09b0\u09bf\u09b6\u09cd\u09b0\u09ae\u09c7\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b9\u09af\u09bc \u09a8\u09be\u0964 \u09ac\u09b0\u0982 \u098f \u099c\u09a8\u09cd\u09af \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09a8\u09bf\u099c\u09c7\u09b0 \u09aa\u09cd\u09b0\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf\u09b0 \u09ac\u099b\u09be\u09a7\u09a8\u099f\u09be \u098f\u0995\u099f\u09c1 \u0986\u09b2\u0997\u09be \u0995\u09b0\u09c7 \u09a6\u09c7\u09af\u09bc\u09be\u0987 \u09af\u09a5\u09c7\u09b7\u09cd\u099f\u0964 \u09a4\u09be\u09b0\u09aa\u09b0 \u09ae\u09be\u09a8\u09c1\u09b7 \u0986\u09aa\u09a8\u09be \u0986\u09aa\u09a8\u09bf \u0997\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09c7\u09a4\u09c7 \u09a5\u09be\u0995\u09c7\u0964 \u098f\u0996\u09a8 \u098f\u0987 \u09af\u09c7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0995\u09c7 \u0986\u09ae\u09bf \u09a6\u09c1\u2019\u099f\u09bf \u09aa\u09a5\u0987 \u09a6\u09c7\u0996\u09bf\u09af\u09bc\u09c7 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09bf\u09b2\u09be\u09ae \u09b8\u09c7 \u0990 \u09a6\u09c1\u2019\u099f\u09bf \u09aa\u09a5\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af \u09a5\u09c7\u0995\u09c7 \u09a8\u09c0\u099a\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u09a8\u09c7\u09ae\u09c7 \u09af\u09be\u0993\u09df\u09be\u09b0 \u09aa\u09a5\u099f\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u0993\u09aa\u09b0\u09c7\u09b0 \u09a6\u09bf\u0995\u09c7 \u09af\u09c7 \u09aa\u09a5\u099f\u09bf \u0997\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u09b8\u09c7\u099f\u09bf \u09aa\u09b0\u09bf\u09a4\u09cd\u09af\u09be\u0997 \u0995\u09b0\u09c7\u099b\u09c7\u0964"},{"id":"6034","sura":"90","aya":"11","arabic_text":"\u0641\u064e\u0644\u064e\u0627 \u0671\u0642\u06e1\u062a\u064e\u062d\u064e\u0645\u064e \u0671\u0644\u06e1\u0639\u064e\u0642\u064e\u0628\u064e\u0629\u064e","translation":"\u09a4\u09ac\u09c7 \u09b8\u09c7 \u09a4\u09cb \u09ac\u09a8\u09cd\u09a7\u09c1\u09b0 \u0997\u09bf\u09b0\u09bf\u09aa\u09a5\u09c7 [\u09e7] \u09aa\u09cd\u09b0\u09ac\u09c7\u09b6 \u0995\u09b0\u09c7\u09a8\u09bf\u0964","footnotes":"[\u09e7] \u0639\u0642\u0628\u0629 \u09ac\u09b2\u09be \u09b9\u09af\u09bc \u09aa\u09be\u09b9\u09be\u09a1\u09bc\u09c7\u09b0 \u09ac\u09bf\u09b0\u09be\u099f \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09b0 \u0996\u09a3\u09cd\u09a1\u0995\u09c7 \u098f\u09ac\u0982 \u09a6\u09c1\u0987 \u09aa\u09be\u09b9\u09be\u09a1\u09bc\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09ac\u09b0\u09cd\u09a4\u09c0 \u0997\u09bf\u09b0\u09bf\u09aa\u09a5\u0995\u09c7\u0964 [\u09ab\u09be\u09a4\u09b9\u09c1\u09b2 \u0995\u09be\u09a6\u09c0\u09b0]"},{"id":"6035","sura":"90","aya":"12","arabic_text":"\u0648\u064e\u0645\u064e\u0627\u0653 \u0623\u064e\u062f\u06e1\u0631\u064e\u0649\u0670\u0643\u064e \u0645\u064e\u0627 \u0671\u0644\u06e1\u0639\u064e\u0642\u064e\u0628\u064e\u0629\u064f","translation":"\u0986\u09b0 \u0995\u09bf\u09b8\u09c7 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u099c\u09be\u09a8\u09be\u09ac\u09c7--- \u09ac\u09a8\u09cd\u09a7\u09c1\u09b0 \u0997\u09bf\u09b0\u09bf\u09aa\u09a5 \u0995\u09c0?","footnotes":""},{"id":"6036","sura":"90","aya":"13","arabic_text":"\u0641\u064e\u0643\u0651\u064f \u0631\u064e\u0642\u064e\u0628\u064e\u0629\u064d","translation":"\u098f\u099f\u09be \u09b9\u099a\u09cd\u099b\u09c7: \u09a6\u09be\u09b8\u09ae\u09c1\u0995\u09cd\u09a4\u09bf [\u09e7]","footnotes":"[\u09e7] \u098f\u09b8\u09ac \u09b8\u09ce\u0995\u09b0\u09cd\u09ae\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u09a5\u09ae\u09c7 \u09a6\u09be\u09b8\u09ae\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09be\u09b0 \u0995\u09a5\u09be \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u098f\u099f\u09be \u0996\u09c1\u09ac \u09ac\u09a1\u09bc \u0987\u09ac\u09be\u09a6\u09a4 \u098f\u09ac\u0982 \u098f\u0995\u099c\u09a8 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u099c\u09c0\u09ac\u09a8 \u09b8\u09c1\u09b8\u0982\u09b9\u09a4 \u0995\u09b0\u09be\u09b0 \u09a8\u09be\u09ae\u09be\u09a8\u09cd\u09a4\u09b0\u0964 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09b9\u09be\u09a6\u09c0\u09b8\u09c7 \u098f\u09b0 \u0985\u09a8\u09c7\u0995 \u09b8\u0993\u09af\u09bc\u09be\u09ac\u09c7\u09b0 \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u098f\u09b8\u09c7\u099b\u09c7\u0964 \u098f\u0995 \u09b9\u09be\u09a6\u09c0\u09b8\u09c7 \u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09af\u09bc\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09ac\u09b2\u09c7\u09a8, \u201c\u09af\u09c7 \u0995\u09c7\u0989 \u0995\u09cb\u09a8\u09cb \u09a6\u09be\u09b8\u0995\u09c7 \u09ae\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09ac\u09c7 \u09b8\u09c7\u099f\u09be \u09a4\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u099c\u09be\u09b9\u09be\u09a8\u09cd\u09a8\u09be\u09ae\u09c7\u09b0 \u0986\u0997\u09c1\u09a8 \u09a5\u09c7\u0995\u09c7 \u09ae\u09c1\u0995\u09cd\u09a4\u09bf\u09aa\u09a3 \u09b9\u09bf\u09b8\u09c7\u09ac\u09c7 \u09ac\u09bf\u09ac\u09c7\u099a\u09bf\u09a4 \u09b9\u09ac\u09c7\u0964\u201d [\u09ae\u09c1\u09b8\u09a8\u09be\u09a6\u09c7 \u0986\u09b9\u09ae\u09be\u09a6 \u09ea\/\u09e7\u09ea\u09ed, \u09e7\u09eb\u09e6]"},{"id":"6037","sura":"90","aya":"14","arabic_text":"\u0623\u064e\u0648\u06e1 \u0625\u0650\u0637\u06e1\u0639\u064e\u0670\u0645\u065e \u0641\u0650\u064a \u064a\u064e\u0648\u06e1\u0645\u0656 \u0630\u0650\u064a \u0645\u064e\u0633\u06e1\u063a\u064e\u0628\u064e\u0629\u0656","translation":"\u0985\u09a5\u09ac\u09be \u09a6\u09c1\u09b0\u09cd\u09ad\u09bf\u0995\u09cd\u09b7\u09c7\u09b0 \u09a6\u09bf\u09a8\u09c7 \u0996\u09be\u09a6\u09cd\u09af\u09a6\u09be\u09a8 [\u09e7]\u2014","footnotes":"[\u09e7] \u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc \u09b8\u09ce\u0995\u09b0\u09cd\u09ae \u09b9\u099a\u09cd\u099b\u09c7 \u0995\u09cd\u09b7\u09c1\u09a7\u09be\u09b0\u09cd\u09a4\u0995\u09c7 \u0985\u09a8\u09cd\u09a8\u09a6\u09be\u09a8\u0964 \u09af\u09c7 \u0995\u09be\u0989\u0995\u09c7 \u0985\u09a8\u09cd\u09a8\u09a6\u09be\u09a8 \u0995\u09b0\u09b2\u09c7 \u09a4\u09be \u0986\u09b0\u0993 \u09ac\u09bf\u09b0\u09be\u099f \u09b8\u0993\u09af\u09bc\u09be\u09ac\u09c7\u09b0 \u0995\u09be\u099c \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u09af\u09bc\u0964 \u09a4\u09be\u0987 \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u09ac\u09bf\u09b6\u09c7\u09b7\u09ad\u09be\u09ac\u09c7 \u09af\u09a6\u09bf \u0986\u09a4\u09cd\u09ae\u09c0\u09af\u09bc \u0987\u09af\u09bc\u09be\u09a4\u09c0\u09ae\u0995\u09c7 \u0985\u09a8\u09cd\u09a8\u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09b9\u09af\u09bc, \u09a4\u09ac\u09c7 \u09a4\u09be\u09a4\u09c7 \u09a6\u09cd\u09ac\u09bf\u0997\u09c1\u09a3 \u09b8\u0993\u09af\u09bc\u09be\u09ac \u09b9\u09af\u09bc\u0964 (\u098f\u0995) \u0995\u09cd\u09b7\u09c1\u09a7\u09be\u09b0\u09cd\u09a4\u09c7\u09b0 \u0995\u09cd\u09b7\u09c1\u09a7\u09be \u09a6\u09c2\u09b0 \u0995\u09b0\u09be\u09b0 \u09b8\u0993\u09af\u09bc\u09be\u09ac \u098f\u09ac\u0982 (\u09a6\u09c1\u0987) \u0986\u09a4\u09cd\u09ae\u09c0\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09be \u0993 \u09a4\u09be\u09b0 \u09b9\u0995 \u0986\u09a6\u09be\u09af\u09bc \u0995\u09b0\u09be\u09b0 \u09b8\u0993\u09af\u09bc\u09be\u09ac\u0964 \u099c\u09be\u09ac\u09c7\u09b0 \u0987\u09ac\u09a8 \u0986\u09ac\u09a6\u09c1\u09b2\u09cd\u09b2\u09be\u09b9 \u09ac\u09b2\u09c7\u09a8, \u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09af\u09bc\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09ac\u09b2\u09c7\u099b\u09c7\u09a8, \u201c\u0995\u09cb\u09a8\u09cb \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u0995\u09cd\u09b7\u09c1\u09a7\u09be\u09b0\u09cd\u09a4\u0995\u09c7 \u0985\u09a8\u09cd\u09a8\u09a6\u09be\u09a8 \u0995\u09cd\u09b7\u09ae\u09be\u0995\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u09ae\u09cd\u09ad\u09be\u09ac\u09c0 \u0995\u09b0\u09c7\u0964\u201d [\u09ae\u09c1\u09b8\u09cd\u09a4\u09be\u09a6\u09b0\u09be\u0995\u09c7 \u09b9\u09be\u0995\u09bf\u09ae \u09e8\/\u09eb\u09e8\u09ea]"},{"id":"6038","sura":"90","aya":"15","arabic_text":"\u064a\u064e\u062a\u0650\u064a\u0645\u0657\u0627 \u0630\u064e\u0627 \u0645\u064e\u0642\u06e1\u0631\u064e\u0628\u064e\u0629\u064d","translation":"\u0987\u09af\u09bc\u09be\u09a4\u09c0\u09ae \u0986\u09a4\u09cd\u09ae\u09c0\u09af\u09bc\u0995\u09c7 [\u09e7],","footnotes":"[\u09e7] \u098f \u09a7\u09b0\u09a8\u09c7\u09b0 \u0987\u09af\u09bc\u09be\u09a4\u09c0\u09ae\u09c7\u09b0 \u09b9\u0995 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09c0\u0964 \u098f\u0995\u09a6\u09bf\u0995\u09c7 \u09b8\u09c7 \u0987\u09af\u09bc\u09be\u09a4\u09c0\u09ae, \u09a6\u09cd\u09ac\u09bf\u09a4\u09c0\u09af\u09bc\u09a4 \u09b8\u09c7 \u09a4\u09be\u09b0 \u09a8\u09bf\u0995\u099f\u09be\u09a4\u09cd\u09ae\u09c0\u09af\u09bc\u0964 \u09b0\u09be\u09b8\u09c2\u09b2\u09c1\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09af\u09bc\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09ac\u09b2\u09c7\u09a8, \u2018\u09ae\u09bf\u09b8\u0995\u09c0\u09a8\u0995\u09c7 \u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09a8\u09bf\u0983\u09b8\u09a8\u09cd\u09a6\u09c7\u09b9\u09c7 \u098f\u0995\u099f\u09bf \u09a6\u09be\u09a8 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09a4\u09cd\u09ae\u09c0\u09af\u09bc\u09a6\u09c7\u09b0 \u09a6\u09be\u09a8 \u0995\u09b0\u09be \u09a6\u09c1\u2019\u099f\u09bf\u0964 \u09a6\u09be\u09a8 \u0993 \u0986\u09a4\u09cd\u09ae\u09c0\u09af\u09bc\u09a4\u09be\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u0964 [\u09ae\u09c1\u09b8\u09a8\u09be\u09a6\u09c7 \u0986\u09b9\u09ae\u09be\u09a6 \u09ea\/\u09e8\u09e7\u09ea, \u09a4\u09bf\u09b0\u09ae\u09bf\u09af\u09bc\u09c0 \u09ec\u09eb\u09e9]"},{"id":"6039","sura":"90","aya":"16","arabic_text":"\u0623\u064e\u0648\u06e1 \u0645\u0650\u0633\u06e1\u0643\u0650\u064a\u0646\u0657\u0627 \u0630\u064e\u0627 \u0645\u064e\u062a\u06e1\u0631\u064e\u0628\u064e\u0629\u0656","translation":"\u0985\u09a5\u09ac\u09be \u09a6\u09be\u09b0\u09bf\u09a6\u09cd\u09b0-\u09a8\u09bf\u09b7\u09cd\u09aa\u09c7\u09b7\u09bf\u09a4 \u09a8\u09bf\u0983\u09b8\u09cd\u09ac\u0995\u09c7,","footnotes":""},{"id":"6040","sura":"90","aya":"17","arabic_text":"\u062b\u064f\u0645\u0651\u064e \u0643\u064e\u0627\u0646\u064e \u0645\u0650\u0646\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u0652 \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0671\u0644\u0635\u0651\u064e\u0628\u06e1\u0631\u0650 \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u06e1\u0627\u0652 \u0628\u0650\u0671\u0644\u06e1\u0645\u064e\u0631\u06e1\u062d\u064e\u0645\u064e\u0629\u0650","translation":"\u09a4\u09a6\u09c1\u09aa\u09b0\u09bf \u09b8\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b9\u09af\u09bc\u09c7 \u09af\u09be\u09af\u09bc \u09af\u09be\u09b0\u09be \u0988\u09ae\u09be\u09a8 \u098f\u09a8\u09c7\u099b\u09c7 \u098f\u09ac\u0982 \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0\u0995\u09c7 \u0989\u09aa\u09a6\u09c7\u09b6 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u09a7\u09c8\u09b0\u09cd\u09af \u09a7\u09be\u09b0\u09a3\u09c7\u09b0, \u0986\u09b0 \u09aa\u09b0\u09b8\u09cd\u09aa\u09b0 \u0989\u09aa\u09a6\u09c7\u09b6 \u09a6\u09bf\u09af\u09bc\u09c7\u099b\u09c7 \u09a6\u09af\u09bc\u09be \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9\u09c7\u09b0 [\u09e7] ;","footnotes":"[\u09e7] \u098f \u0986\u09af\u09bc\u09be\u09a4\u09c7 \u0988\u09ae\u09be\u09a8\u09c7\u09b0 \u09aa\u09b0 \u09ae\u09c1\u09ae\u09bf\u09a8\u09c7\u09b0 \u098f\u0987 \u0995\u09b0\u09cd\u09a4\u09ac\u09cd\u09af \u09ac\u09cd\u09af\u0995\u09cd\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u09af\u09c7, \u09b8\u09c7 \u0985\u09aa\u09b0\u09be\u09aa\u09b0 \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u09ad\u09be\u0987\u0995\u09c7 \u09b8\u09ac\u09b0 \u0993 \u0985\u09a8\u09c1\u0995\u09ae\u09cd\u09aa\u09be\u09b0 \u0989\u09aa\u09a6\u09c7\u09b6 \u09a6\u09c7\u09ac\u09c7\u0964 \u09b8\u09ac\u09b0\u09c7\u09b0 \u0985\u09b0\u09cd\u09a5 \u09a8\u09bf\u099c\u09c7\u0995\u09c7 \u09ae\u09a8\u09cd\u09a6 \u0995\u09be\u099c \u09a5\u09c7\u0995\u09c7 \u09ac\u09be\u0981\u099a\u09bf\u09af\u09bc\u09c7 \u09b0\u09be\u0996\u09be \u0993 \u09b8\u09ce\u0995\u09b0\u09cd\u09ae \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8 \u0995\u09b0\u09be\u0964 \u0645\u0631\u062d\u0645\u0629 \u098f\u09b0 \u0985\u09b0\u09cd\u09a5 \u0985\u09aa\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09a6\u09af\u09bc\u09be\u09b0\u09cd\u09a6\u09cd\u09b0 \u09b9\u0993\u09af\u09bc\u09be\u0964 \u0985\u09aa\u09b0\u09c7\u09b0 \u0995\u09b7\u09cd\u099f\u0995\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u0995\u09b7\u09cd\u099f \u09ae\u09a8\u09c7 \u0995\u09b0\u09c7 \u09a4\u09be\u0995\u09c7 \u0995\u09b7\u09cd\u099f\u09a6\u09be\u09a8 \u0993 \u09af\u09c1\u09b2\u09c1\u09ae \u0995\u09b0\u09be \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09b0\u09a4 \u09b9\u0993\u09af\u09bc\u09be\u0964 \u09a8\u09ac\u09c0 \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09b2\u09cd\u09b2\u09be\u09b9\u09c1 \u0986\u09b2\u09be\u0987\u09b9\u09bf \u0993\u09af\u09bc\u09be \u09b8\u09be\u09b2\u09cd\u09b2\u09be\u09ae \u09a8\u09bf\u099c\u09c7\u09b0 \u0989\u09ae\u09cd\u09ae\u09a4\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u0987 \u09b0\u09b9\u09ae \u0993 \u0995\u09b0\u09c1\u09a3\u09be\u09ac\u09c3\u09a4\u09cd\u09a4\u09bf\u099f\u09bf\u09b0 \u09ae\u09a4\u09cb \u0989\u09a8\u09cd\u09a8\u09a4 \u09a8\u09c8\u09a4\u09bf\u0995 \u09ac\u09c3\u09a4\u09cd\u09a4\u09bf\u099f\u09bf\u0995\u09c7\u0987 \u09b8\u09ac\u099a\u09c7\u09af\u09bc\u09c7 \u09ac\u09c7\u09b6\u09c0 \u09aa\u09cd\u09b0\u09b8\u09be\u09b0\u09bf\u09a4 \u0993 \u09ac\u09bf\u0995\u09b6\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u099a\u09c7\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964 \u09b9\u09be\u09a6\u09c0\u09b8\u09c7 \u098f\u09b8\u09c7\u099b\u09c7, \u201c\u09af\u09c7 \u09ae\u09be\u09a8\u09c1\u09b7\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0\u09c7 \u09a8\u09be \u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09cd \u09a4\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0\u09c7\u09a8 \u09a8\u09be\u0964\u201d [\u09ac\u09c1\u0996\u09be\u09b0\u09c0 \u09ed\u09e9\u09ed\u09ec, \u09ae\u09c1\u09b8\u09b2\u09bf\u09ae \u09e9\u09e7\u09ef, \u09ae\u09c1\u09b8\u09a8\u09be\u09a6\u09c7 \u0986\u09b9\u09ae\u09be\u09a6 \u09ea\/\u09eb\u09ec\u09e8] \u0985\u09a8\u09cd\u09af \u09b9\u09be\u09a6\u09c0\u09b8\u09c7 \u098f\u09b8\u09c7\u099b\u09c7, \u201c\u09af\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099b\u09cb\u099f\u09a6\u09c7\u09b0 \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0\u09c7 \u09a8\u09be \u098f\u09ac\u0982 \u09ac\u09a1\u09bc\u09a6\u09c7\u09b0 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8 \u09aa\u09be\u0993\u09af\u09bc\u09be\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u0996\u09c7\u09af\u09bc\u09be\u09b2 \u09b0\u09be\u0996\u09c7 \u09a8\u09be \u09b8\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09b2\u09ad\u09c1\u0995\u09cd\u09a4 \u09a8\u09af\u09bc\u0964\u201d [\u0986\u09ac\u09c1\u09a6\u09be\u0989\u09a6 \u09ea\u09ef\u09ea\u09e9, \u09a4\u09bf\u09b0\u09ae\u09bf\u09af\u09bc\u09c0 \u09e7\u09ef\u09e8\u09e6] \u0986\u09b0\u0993 \u09ac\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7, \u201c\u09af\u09be\u09b0\u09be \u09b0\u09b9\u09ae\u09a4\u09c7\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0\u09c0 (\u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7) \u09a4\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b0\u09b9\u09ae\u09be\u09a8 \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0\u09c7\u09a8, \u09a4\u09cb\u09ae\u09b0\u09be \u09af\u09ae\u09c0\u09a8\u09c7\u09b0 \u0985\u09a7\u09bf\u09ac\u09be\u09b8\u09c0\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0 \u09a4\u09ac\u09c7 \u0986\u09b8\u09ae\u09be\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09af\u09bf\u09a8\u09bf \u0986\u099b\u09c7\u09a8 (\u0986\u09b2\u09cd\u09b2\u09be\u09b9\u09cd) \u09a4\u09bf\u09a8\u09bf\u0993 \u09a4\u09cb\u09ae\u09be\u09a6\u09c7\u09b0\u0995\u09c7 \u09b0\u09b9\u09ae\u09a4 \u0995\u09b0\u09ac\u09c7\u09a8\u0964\u201d [\u0986\u09ac\u09c1 \u09a6\u09be\u0989\u09a6 \u09ea\u09ef\u09ea\u09e7, \u09a4\u09bf\u09b0\u09ae\u09bf\u09af\u09bc\u09c0 \u09e7\u09ef\u09e8\u09ea]"},{"id":"6041","sura":"90","aya":"18","arabic_text":"\u0623\u064f\u0648\u0652\u0644\u064e\u0670\u0653\u0626\u0650\u0643\u064e \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u06e1\u0645\u064e\u064a\u06e1\u0645\u064e\u0646\u064e\u0629\u0650","translation":"\u09a4\u09be\u09b0\u09be\u0987 \u09b8\u09cc\u09ad\u09be\u0997\u09cd\u09af\u09b6\u09be\u09b2\u09c0\u0964","footnotes":""},{"id":"6042","sura":"90","aya":"19","arabic_text":"\u0648\u064e\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0643\u064e\u0641\u064e\u0631\u064f\u0648\u0627\u0652 \u0628\u0650\u0640\u0654\u064e\u0627\u064a\u064e\u0670\u062a\u0650\u0646\u064e\u0627 \u0647\u064f\u0645\u06e1 \u0623\u064e\u0635\u06e1\u062d\u064e\u0670\u0628\u064f \u0671\u0644\u06e1\u0645\u064e\u0634\u06e1\u0640\u0654\u064e\u0645\u064e\u0629\u0650","translation":"\u0986\u09b0 \u09af\u09be\u09b0\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0986\u09af\u09bc\u09be\u09a4\u09b8\u09ae\u09c2\u09b9\u09c7 \u0995\u09c1\u09ab\u09b0\u09c0 \u0995\u09b0\u09c7\u099b\u09c7, \u09a4\u09be\u09b0\u09be\u0987 \u09b9\u09a4\u09ad\u09be\u0997\u09cd\u09af\u0964","footnotes":""},{"id":"6043","sura":"90","aya":"20","arabic_text":"\u0639\u064e\u0644\u064e\u064a\u06e1\u0647\u0650\u0645\u06e1 \u0646\u064e\u0627\u0631\u065e \u0645\u0651\u064f\u0624\u06e1\u0635\u064e\u062f\u064e\u0629\u064f\u06e2","translation":"\u09a4\u09be\u09b0\u09be \u09aa\u09b0\u09bf\u09ac\u09c7\u09b7\u09cd\u099f\u09bf\u09a4 \u09b9\u09ac\u09c7 \u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7 \u0986\u0997\u09c1\u09a8\u09c7\u0964","footnotes":""}]}